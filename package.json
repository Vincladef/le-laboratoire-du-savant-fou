{
  "name": "le-laboratoire-du-savant-fou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch scripts/dev-server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:netlify": "tsx scripts/netlify-prepare.ts && tsx scripts/verify-ai-provider.ts && npm run build",
    "build:functions": "tsx scripts/build-functions.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server scripts tests netlify '*.ts' package.json tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "billing:configure": "tsx scripts/provision-stripe.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@hono/node-server": "^2.1.5",
    "@neondatabase/auth": "0.6.0-beta",
    "@netlify/blobs": "^11.1.4",
    "@tanstack/react-query": "^5.104.2",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.7",
    "docx": "^9.11.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "idb": "^8.0.4",
    "katex": "^0.18.10",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "stripe": "23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@netlify/functions": "^6.0.2",
    "@netlify/zip-it-and-ship-it": "^16.3.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
