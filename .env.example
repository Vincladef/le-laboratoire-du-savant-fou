# Variables serveur Netlify configurées par API, jamais VITE_*.
# Exemple de noms uniquement : aucun secret dans ce fichier.
DATABASE_URL=
BETTER_AUTH_SECRET=
AUTH_BASE_URL=https://bouche-trou.netlify.app
NEON_AUTH_BASE_URL=https://ep-wispy-lake-ba7v96jl.neonauth.c-8.eu-central-1.aws.neon.tech/laboratoire/auth
# Facultatif : sujet propriétaire réservé par une opération administrative vérifiée.
OWNER_NEON_SUBJECT=
# Email et Google se configurent dans Neon ; Blobs utilise le contexte du site.
# Le mode local utilise PGlite et une boîte email locale, pas ces accès de production.
# Facturation facultative : absence => ventes fermées, application et données préservées.
# Variables privées, valeurs par canal sécurisé uniquement (voir docs/billing.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_MODE=test
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_CHECKOUT_ENABLED=0
# Coordonnées publiques et conditions réellement validées, JSON selon server/legal.ts.
LEGAL_PUBLIC_CONFIG=
